# Local development: run `npm run db:local` in another terminal (embedded Postgres via PGlite).
# To use your Vercel/Neon database instead: `vercel env pull .env` (overwrites this file).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable"
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob — leave unset locally to store documents on disk under ./storage
# BLOB_READ_WRITE_TOKEN=""
# BLOB_ACCESS="private"   # set to "public" if your Blob store was created as public
